{
  "name": "@ai-workflow/server",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "files": ["dist", "install-pilot-atomic-publish.mjs"],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prepilot:seed": "npm run build:pilot-helper",
    "pilot:seed": "tsx src/pilot-fixture.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && npm run build:pilot-helper",
    "build:pilot-helper": "node scripts/build-pilot-atomic-publish.mjs",
    "prepack": "npm run build",
    "postinstall": "node install-pilot-atomic-publish.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-workflow/shared": "*",
    "@fastify/cors": "^11.0.0",
    "fastify": "^5.4.0",
    "openai": "^5.8.0",
    "tsx": "^4.20.0"
  }
}
